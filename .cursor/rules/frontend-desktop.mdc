## Padrões de Código

### Comunicação entre Main e Renderer SEMPRE via preload
```typescript
// preload/index.ts — expõe API segura para o renderer
import { contextBridge, ipcRenderer } from 'electron'

contextBridge.exposeInMainWorld('electronAPI', {
  onClipboardChange: (callback: (text: string) => void) =>
    ipcRenderer.on('clipboard:changed', (_event, text) => callback(text)),
  analyzeText: (text: string) =>
    ipcRenderer.invoke('text:analyze', text),
})

// NUNCA faça isso no renderer:
// const { ipcRenderer } = require('electron') ← ERRADO, nodeIntegration off
```

### Janela flutuante transparente
```typescript
// main/windows/mainWindow.ts
import { BrowserWindow } from 'electron'

export function createFloatingWindow(): BrowserWindow {
  return new BrowserWindow({
    width: 380,
    height: 520,
    transparent: true,
    frame: false,
    alwaysOnTop: true,
    skipTaskbar: true,
    resizable: false,
    webPreferences: {
      preload: path.join(__dirname, '../preload/index.js'),
      nodeIntegration: false,      // sempre false
      contextIsolation: true,      // sempre true
    },
  })
}
```

